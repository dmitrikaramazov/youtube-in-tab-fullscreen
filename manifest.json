{
  "manifest_version": 3,
  "name": "YouTube In-Tab Fullscreen",
  "version": "1.0.0",
  "description": "Maximize the YouTube player to fill the browser tab viewport. Use the custom player button, click the extension icon, or press Alt+Shift+T.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Toggle In-Tab Fullscreen"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "commands": {
    "toggle-in-tab": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Toggle YouTube In-Tab Fullscreen"
    }
  }
}
